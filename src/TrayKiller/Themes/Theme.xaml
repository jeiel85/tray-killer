<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:ui="clr-namespace:TrayKiller.UI">

    <!-- ── Palette ─────────────────────────────────────────────────────────── -->
    <Color x:Key="C.Bg">#0B0D12</Color>
    <Color x:Key="C.Side">#0E1117</Color>
    <Color x:Key="C.Surface">#131720</Color>
    <Color x:Key="C.Surface2">#191E29</Color>
    <Color x:Key="C.Surface3">#222835</Color>
    <Color x:Key="C.Border">#212734</Color>
    <Color x:Key="C.BorderStrong">#2C3343</Color>
    <Color x:Key="C.Text">#EDF0F6</Color>
    <Color x:Key="C.Muted">#8D95A8</Color>
    <Color x:Key="C.Subtle">#5F6779</Color>
    <Color x:Key="C.Accent">#FF2B5E</Color>
    <Color x:Key="C.Accent2">#FF7A2B</Color>
    <Color x:Key="C.Green">#34D399</Color>
    <Color x:Key="C.Amber">#FBBF24</Color>
    <Color x:Key="C.Blue">#60A5FA</Color>
    <Color x:Key="C.Purple">#A78BFA</Color>

    <SolidColorBrush x:Key="B.Bg" Color="{StaticResource C.Bg}" />
    <SolidColorBrush x:Key="B.Side" Color="{StaticResource C.Side}" />
    <SolidColorBrush x:Key="B.Surface" Color="{StaticResource C.Surface}" />
    <SolidColorBrush x:Key="B.Surface2" Color="{StaticResource C.Surface2}" />
    <SolidColorBrush x:Key="B.Surface3" Color="{StaticResource C.Surface3}" />
    <SolidColorBrush x:Key="B.Border" Color="{StaticResource C.Border}" />
    <SolidColorBrush x:Key="B.BorderStrong" Color="{StaticResource C.BorderStrong}" />
    <SolidColorBrush x:Key="B.Text" Color="{StaticResource C.Text}" />
    <SolidColorBrush x:Key="B.Muted" Color="{StaticResource C.Muted}" />
    <SolidColorBrush x:Key="B.Subtle" Color="{StaticResource C.Subtle}" />
    <SolidColorBrush x:Key="B.Accent" Color="{StaticResource C.Accent}" />
    <SolidColorBrush x:Key="B.Accent2" Color="{StaticResource C.Accent2}" />
    <SolidColorBrush x:Key="B.Green" Color="{StaticResource C.Green}" />
    <SolidColorBrush x:Key="B.Amber" Color="{StaticResource C.Amber}" />
    <SolidColorBrush x:Key="B.Blue" Color="{StaticResource C.Blue}" />
    <SolidColorBrush x:Key="B.Purple" Color="{StaticResource C.Purple}" />
    <SolidColorBrush x:Key="B.AccentSoft" Color="#22FF2B5E" />
    <SolidColorBrush x:Key="B.GreenSoft" Color="#1F34D399" />
    <SolidColorBrush x:Key="B.AmberSoft" Color="#1FFBBF24" />
    <SolidColorBrush x:Key="B.BlueSoft" Color="#1F60A5FA" />
    <SolidColorBrush x:Key="B.PurpleSoft" Color="#1FA78BFA" />
    <SolidColorBrush x:Key="B.MutedSoft" Color="#1A8D95A8" />
    <SolidColorBrush x:Key="B.Danger" Color="#FF6B81" />
    <SolidColorBrush x:Key="B.DangerSoft" Color="#1AFF6B81" />

    <LinearGradientBrush x:Key="B.AccentGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource C.Accent}" Offset="0" />
        <GradientStop Color="{StaticResource C.Accent2}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="B.AccentGradH" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource C.Accent}" Offset="0" />
        <GradientStop Color="{StaticResource C.Accent2}" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="B.HeroGlow" Center="0.08,0.1" GradientOrigin="0.08,0.1" RadiusX="0.75" RadiusY="1.6">
        <GradientStop Color="#33FF2B5E" Offset="0" />
        <GradientStop Color="#0DFF7A2B" Offset="0.55" />
        <GradientStop Color="#00FF7A2B" Offset="1" />
    </RadialGradientBrush>

    <!-- ── Type ────────────────────────────────────────────────────────────── -->
    <FontFamily x:Key="UiFont">Segoe UI, Malgun Gothic</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{StaticResource B.Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource B.Muted}" />
    </Style>
    <Style x:Key="Overline" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource B.Subtle}" />
    </Style>
    <Style x:Key="Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- ── Containers ──────────────────────────────────────────────────────── -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource B.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="22" />
    </Style>
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- ── Buttons ─────────────────────────────────────────────────────────── -->
    <Style x:Key="Btn" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="Background" Value="{StaticResource B.Surface2}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Height" Value="38" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="Hover" CornerRadius="10" Background="White" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="0.06" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="0.12" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource B.AccentGrad}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource B.Muted}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Height" Value="34" />
    </Style>
    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
        <Setter Property="Foreground" Value="{StaticResource B.Danger}" />
    </Style>
    <Style x:Key="BtnLink" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
        <Setter Property="Foreground" Value="{StaticResource B.Accent}" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style x:Key="Caption.Btn" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Foreground" Value="{StaticResource B.Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Caption.Close" TargetType="Button" BasedOn="{StaticResource Caption.Btn}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E81123" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Toggle switch ───────────────────────────────────────────────────── -->
    <Style x:Key="Toggle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="44" Height="24" Background="Transparent">
                        <Border x:Name="Track" CornerRadius="12" Background="{StaticResource B.Surface3}"
                                BorderBrush="{StaticResource B.BorderStrong}" BorderThickness="1" />
                        <Ellipse x:Name="Knob" Width="16" Height="16" Fill="{StaticResource B.Muted}"
                                 HorizontalAlignment="Left" Margin="4,0,0,0">
                            <Ellipse.RenderTransform>
                                <TranslateTransform X="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource B.AccentGradH}" />
                            <Setter TargetName="Track" Property="BorderThickness" Value="0" />
                            <Setter TargetName="Knob" Property="Fill" Value="White" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="20" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="0" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource B.Subtle}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Chip (checkable pill) ───────────────────────────────────────────── -->
    <Style x:Key="Chip" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{StaticResource B.Muted}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Bd" CornerRadius="9" Padding="10,6,12,6" Background="{StaticResource B.Surface2}"
                            BorderBrush="{StaticResource B.Border}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="16" Height="16" Margin="0,0,7,0">
                                <Border x:Name="Box" CornerRadius="5" BorderBrush="{StaticResource B.Subtle}" BorderThickness="1.5" />
                                <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.AccentSoft}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#55FF2B5E" />
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource B.AccentGrad}" />
                            <Setter TargetName="Box" Property="BorderThickness" Value="0" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Subtle}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Sidebar navigation ──────────────────────────────────────────────── -->
    <Style x:Key="Nav" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource B.Muted}" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="GroupName" Value="Nav" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Bg" CornerRadius="10" Background="Transparent" />
                        <Border x:Name="Bar" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left"
                                Background="{StaticResource B.AccentGrad}" Opacity="0" />
                        <ContentPresenter Margin="14,0,12,0" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource B.Surface}" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource B.Surface2}" />
                            <Setter TargetName="Bar" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Segmented control ───────────────────────────────────────────────── -->
    <Style x:Key="Seg" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource B.Muted}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="8" Padding="12,6" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Surface3}" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SegHost" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource B.Bg}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- ── Text input ──────────────────────────────────────────────────────── -->
    <Style x:Key="Input" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="Background" Value="{StaticResource B.Surface2}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.BorderStrong}" />
        <Setter Property="CaretBrush" Value="White" />
        <Setter Property="SelectionBrush" Value="{StaticResource B.Accent}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="10" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Scrollbars ──────────────────────────────────────────────────────── -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border CornerRadius="3" Background="#2E3546" Margin="2,2,3,2" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" Background="#2E3546" Margin="2,2,2,3" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── Tooltip ─────────────────────────────────────────────────────────── -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#1E2330" BorderBrush="{StaticResource B.BorderStrong}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── List items (picker) ─────────────────────────────────────────────── -->
    <Style x:Key="PickItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="12" Padding="12,10" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Surface2}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.AccentSoft}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#66FF2B5E" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Tray context menu ───────────────────────────────────────────────── -->
    <Style x:Key="TrayMenu" TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="14" Padding="6" CornerRadius="14" Background="#151922" BorderBrush="#2A3141" BorderThickness="1" MinWidth="264">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.55" Color="Black" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TrayMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" CornerRadius="9" Padding="10,9" Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Ico" Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}" FontSize="15"
                                       VerticalAlignment="Center" Foreground="{StaticResource B.Muted}" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{StaticResource B.Subtle}"
                                       FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Surface3}" />
                            <Setter TargetName="Ico" Property="Foreground" Value="{StaticResource B.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TrayMenuSep" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="#252B39" Margin="10,6" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Converters ──────────────────────────────────────────────────────── -->
    <ui:BoolToVis x:Key="BoolToVis" />
    <ui:BoolToVis x:Key="InvBoolToVis" Invert="True" />
    <ui:NullToVis x:Key="NullToVis" />
    <ui:NullToVis x:Key="NotNullToVis" Invert="True" />
    <ui:CountToVis x:Key="CountToVis" />
    <ui:CountToVis x:Key="ZeroToVis" Invert="True" />
    <ui:EqualsToBool x:Key="EqualsToBool" />

    <!-- ── Shared row templates ────────────────────────────────────────────── -->
    <DataTemplate x:Key="ActivityRow">
        <Grid Margin="0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="34" Height="34" CornerRadius="10" Background="{Binding Soft}" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="14" Foreground="{Binding Brush}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource B.Text}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource B.Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                           Visibility="{Binding Detail, Converter={StaticResource NotNullToVis}}" ToolTip="{Binding Detail}" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding TimeText}" Style="{StaticResource Caption}" Foreground="{StaticResource B.Subtle}" VerticalAlignment="Center" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>
