<UserControl x:Class="TrayKiller.UI.ActivityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:TrayKiller.Core">
    <DockPanel Margin="36,0,36,0">
        <StackPanel DockPanel.Dock="Top">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Click="Clear_Click" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="12" />
                        <TextBlock Text="{l:T btn.clearLog}" Margin="7,0,0,0" />
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="{l:T activity.title}" />
                    <TextBlock Style="{StaticResource Sub}" Text="{l:T activity.sub}" Margin="0,6,0,0" />
                </StackPanel>
            </DockPanel>
            <Border Style="{StaticResource SegHost}" Margin="0,20,0,16">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Seg}" GroupName="Filter" Content="{l:T filter.all}" Tag="all" IsChecked="True" Checked="Filter_Checked" />
                    <RadioButton Style="{StaticResource Seg}" GroupName="Filter" Content="{l:T filter.kill}" Tag="kill" Checked="Filter_Checked" />
                    <RadioButton Style="{StaticResource Seg}" GroupName="Filter" Content="{l:T filter.block}" Tag="block" Checked="Filter_Checked" />
                    <RadioButton Style="{StaticResource Seg}" GroupName="Filter" Content="{l:T filter.system}" Tag="system" Checked="Filter_Checked" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <ItemsControl x:Name="List" ItemTemplate="{StaticResource ActivityRow}" Margin="0,0,0,32" Focusable="False">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <StackPanel Margin="0,0,0,18">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Overline}" Margin="4,0,0,8" />
                                                    <Border Style="{StaticResource Card}" Padding="18,8">
                                                        <ItemsPresenter />
                                                    </Border>
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE81C;" FontSize="34" Foreground="{StaticResource B.Subtle}" />
                <TextBlock Style="{StaticResource Sub}" Text="{l:T activity.empty}" Margin="0,12,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
