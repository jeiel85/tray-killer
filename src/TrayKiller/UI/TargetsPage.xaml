<UserControl x:Class="TrayKiller.UI.TargetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:TrayKiller.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="36,0,36,32">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Click="Add_Click" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="12" Foreground="White" />
                        <TextBlock Text="{l:T btn.addApp}" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="{l:T targets.title}" />
                    <TextBlock Style="{StaticResource Sub}" Text="{l:T targets.sub}" Margin="0,6,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- limited mode notice -->
            <Border Margin="0,20,0,0" CornerRadius="12" Padding="16,12" Background="{StaticResource B.AmberSoft}" BorderBrush="#33FBBF24" BorderThickness="1"
                    Visibility="{Binding ShowElevateBanner, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Foreground="{StaticResource B.Amber}" Content="{l:T btn.elevate}" Click="Elevate_Click" />
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" Foreground="{StaticResource B.Amber}" FontSize="15" />
                    <TextBlock Text="{l:T targets.limited}" Foreground="{StaticResource B.Text}" FontSize="12.5" TextWrapping="Wrap" Margin="12,0,0,0" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- empty state -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="40" Visibility="{Binding NoRules, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center">
                    <Grid Width="72" Height="72" HorizontalAlignment="Center">
                        <Ellipse Fill="{StaticResource B.AccentSoft}" />
                        <Image Source="/Assets/logo-128.png" Width="40" Height="40" Opacity="0.9" />
                    </Grid>
                    <TextBlock Style="{StaticResource H2}" Text="{l:T targets.empty.title}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock Style="{StaticResource Sub}" Text="{l:T targets.empty.body}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0" MaxWidth="420" />
                </StackPanel>
            </Border>

            <!-- rule cards -->
            <ItemsControl ItemsSource="{Binding Rules}" Margin="0,20,0,0" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="CardBd" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="50" Height="50" CornerRadius="13" Background="{StaticResource B.Surface2}" BorderBrush="{StaticResource B.Border}" BorderThickness="1">
                                        <Grid>
                                            <Image Source="{Binding Icon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xECAA;" FontSize="20" Foreground="{StaticResource B.Muted}"
                                                       Visibility="{Binding Icon, Converter={StaticResource NullToVis}}" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="15.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <Border CornerRadius="6" Padding="7,2" Background="{StaticResource B.Surface2}">
                                                <TextBlock Text="{Binding Pattern}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource B.Text}" />
                                            </Border>
                                            <TextBlock Text="{Binding PathText}" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="420" ToolTip="{Binding PathText}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding KillCountText}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding LastKilledText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="3" Style="{StaticResource Toggle}" IsChecked="{Binding Enabled}" ToolTip="{l:T rule.enabledTip}" />
                                </Grid>
                                <Border Height="1" Background="{StaticResource B.Border}" Margin="0,18,0,14" />
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Style="{StaticResource BtnGhost}" Click="RunNow_Click" Tag="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="12" />
                                                <TextBlock Text="{l:T btn.runNow}" Margin="7,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource BtnDanger}" Click="Delete_Click" Tag="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="12" />
                                                <TextBlock Text="{l:T btn.delete}" Margin="7,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <WrapPanel>
                                        <CheckBox Style="{StaticResource Chip}" IsChecked="{Binding KillProcess}" Content="{l:T rule.kill}" ToolTip="{l:T rule.kill.tip}" />
                                        <CheckBox Style="{StaticResource Chip}" IsChecked="{Binding BlockAutostart}" Content="{l:T rule.autostart}" ToolTip="{l:T rule.autostart.tip}" />
                                        <CheckBox Style="{StaticResource Chip}" IsChecked="{Binding HideTrayIcon}" Content="{l:T rule.hideIcon}" ToolTip="{l:T rule.hideIcon.tip}" />
                                        <CheckBox Style="{StaticResource Chip}" IsChecked="{Binding DisableServices}" Content="{l:T rule.services}" ToolTip="{l:T rule.services.tip}" />
                                    </WrapPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                <Setter TargetName="CardBd" Property="Opacity" Value="0.55" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- blocked items -->
            <StackPanel Margin="0,22,0,10" Visibility="{Binding BlockedItems.Count, Converter={StaticResource CountToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource H2}" Text="{l:T targets.blocked}" VerticalAlignment="Center" />
                    <Border CornerRadius="8" Padding="8,2" Background="{StaticResource B.AmberSoft}" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BlockedCountText}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource B.Accent2}" />
                    </Border>
                </StackPanel>
                <TextBlock Style="{StaticResource Caption}" Text="{l:T targets.blocked.sub}" Margin="0,4,0,0" />
            </StackPanel>
            <Border Style="{StaticResource Card}" Padding="10" Visibility="{Binding BlockedItems.Count, Converter={StaticResource CountToVis}}">
                <ItemsControl ItemsSource="{Binding BlockedItems}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Row" CornerRadius="10" Padding="12,10" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource B.AmberSoft}">
                                        <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="14" Foreground="{StaticResource B.Accent2}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding KindText}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Text="·" Style="{StaticResource Caption}" Margin="6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding RuleName}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Foreground="{StaticResource B.Subtle}" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="11.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TimeText}" Style="{StaticResource Caption}" Foreground="{StaticResource B.Subtle}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <Button Style="{StaticResource Btn}" Height="32" Padding="12,0" Click="Restore_Click" Tag="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A7;" FontSize="12" />
                                                <TextBlock Text="{l:T btn.restore}" Margin="7,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource B.Surface2}" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
