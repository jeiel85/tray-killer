<UserControl x:Class="TrayKiller.UI.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:TrayKiller.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="36,0,36,32">
            <TextBlock Style="{StaticResource H1}" Text="{l:T dash.title}" />
            <TextBlock Style="{StaticResource Sub}" Text="{Binding Greeting}" Margin="0,6,0,0" />

            <!-- ── Hero ─────────────────────────────────────────────── -->
            <Grid Margin="0,24,0,0">
                <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Border Background="{StaticResource B.HeroGlow}" CornerRadius="16" />
                        <Grid Margin="30,28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- radar emblem -->
                            <Grid Width="104" Height="104">
                                <Ellipse Stroke="{Binding StatusBrush}" StrokeThickness="1.5" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform><ScaleTransform /></Ellipse.RenderTransform>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.62" To="1" Duration="0:0:2.4" />
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.62" To="1" Duration="0:0:2.4" />
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.9" To="0" Duration="0:0:2.4" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <Ellipse Stroke="{Binding StatusBrush}" StrokeThickness="1.5" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform><ScaleTransform /></Ellipse.RenderTransform>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" BeginTime="0:0:1.2">
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.62" To="1" Duration="0:0:2.4" />
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.62" To="1" Duration="0:0:2.4" />
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.9" To="0" Duration="0:0:2.4" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <Ellipse Width="80" Height="80" Fill="{Binding StatusSoft}" Stroke="{Binding StatusBrush}" StrokeThickness="1" StrokeDashArray="2 3" />
                                <Image Source="/Assets/logo-128.png" Width="50" Height="50" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Effect>
                                        <DropShadowEffect BlurRadius="22" ShadowDepth="0" Color="#FF2B5E" Opacity="0.65" />
                                    </Image.Effect>
                                </Image>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="28,0,20,0" VerticalAlignment="Center">
                                <Border Style="{StaticResource Pill}" Background="{Binding StatusSoft}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding StatusBrush}" Margin="7,0,0,0" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding HeroTitle}" FontSize="23" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding HeroSubtitle}" Style="{StaticResource Sub}" Margin="0,6,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource Btn}" Click="Pause_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Glyph}" Text="{Binding PauseGlyph}" FontSize="13" />
                                        <TextBlock Text="{Binding PauseText}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BtnPrimary}" Click="Sweep_Click" Margin="10,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="13" Foreground="White" />
                                        <TextBlock Text="{l:T btn.sweep}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── Onboarding (no rules yet) ────────────────────────── -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" BorderBrush="#44FF2B5E" Background="#0FFF2B5E"
                    Visibility="{Binding NoRules, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Click="Add_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="12" Foreground="White" />
                            <TextBlock Text="{l:T btn.addApp}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Style="{StaticResource H2}" Text="{l:T onboard.title}" />
                        <TextBlock Style="{StaticResource Sub}" Text="{l:T onboard.body}" Margin="0,6,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ── Stats ────────────────────────────────────────────── -->
            <ItemsControl ItemsSource="{Binding StatCards}" Margin="-7,16,-7,0" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="7,0" Padding="20,18">
                            <StackPanel>
                                <DockPanel>
                                    <Border Width="34" Height="34" CornerRadius="10" Background="{Binding Soft}">
                                        <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="15" Foreground="{Binding Brush}" />
                                    </Border>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" FontSize="12.5" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{Binding Value}" FontSize="30" FontWeight="SemiBold" Margin="0,16,0,0" />
                                <TextBlock Text="{Binding Caption}" Style="{StaticResource Caption}" Foreground="{StaticResource B.Subtle}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ── Week chart + recent activity ─────────────────────── -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="7*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding WeekTotalText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource H2}" Text="{l:T dash.week}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding WeekBars}" Margin="0,18,0,0" Focusable="False" VerticalAlignment="Bottom">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Bottom" Margin="5,0">
                                        <TextBlock Text="{Binding Count}" HorizontalAlignment="Center" FontSize="11.5" Foreground="{StaticResource B.Muted}" Margin="0,0,0,6" />
                                        <Border Height="{Binding BarHeight}" CornerRadius="6" Background="{Binding Fill}" MaxWidth="30" />
                                        <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontSize="11.5" Foreground="{StaticResource B.Subtle}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,18,22,14">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource BtnLink}" Content="{l:T btn.viewAll}" Click="ViewAll_Click" />
                            <TextBlock Style="{StaticResource H2}" Text="{l:T dash.recent}" VerticalAlignment="Center" />
                        </DockPanel>
                        <Grid>
                            <ItemsControl ItemsSource="{Binding RecentActivity}" ItemTemplate="{StaticResource ActivityRow}" Focusable="False" />
                            <TextBlock Text="{l:T dash.noActivity}" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40"
                                       Visibility="{Binding RecentActivity.Count, Converter={StaticResource ZeroToVis}}" />
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
