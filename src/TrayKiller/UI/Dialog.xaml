<Window x:Class="TrayKiller.UI.Dialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{StaticResource B.Surface}" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource B.Text}" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="0" CornerRadius="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource B.BorderStrong}" BorderThickness="1">
        <StackPanel Margin="26,24,26,22">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="IconBg" Width="36" Height="36" CornerRadius="10" Background="{StaticResource B.AccentSoft}">
                    <TextBlock x:Name="IconGlyph" Style="{StaticResource Glyph}" Text="&#xE7BA;" Foreground="{StaticResource B.Accent}" FontSize="15" />
                </Border>
                <TextBlock x:Name="TitleText" Style="{StaticResource H2}" FontSize="17" Margin="14,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="BodyText" Style="{StaticResource Sub}" Margin="0,16,0,0" LineHeight="20" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="CancelButton" Style="{StaticResource Btn}" MinWidth="88" Click="Cancel_Click" IsCancel="True" />
                <Button x:Name="OkButton" Style="{StaticResource BtnPrimary}" MinWidth="96" Margin="10,0,0,0" Click="Ok_Click" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
