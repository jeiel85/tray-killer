<UserControl x:Class="TrayKiller.UI.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:TrayKiller.Core">
    <UserControl.Resources>
        <Style x:Key="RowIcon" TargetType="Border">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="{StaticResource B.Surface2}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="RowDesc" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style x:Key="RowSep" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource B.Border}" />
            <Setter Property="Margin" Value="0,16" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="36,0,36,32">
            <TextBlock Style="{StaticResource H1}" Text="{l:T settings.title}" />
            <TextBlock Style="{StaticResource Sub}" Text="{l:T settings.sub}" Margin="0,6,0,0" />

            <!-- ── Protection ───────────────────────────────────────── -->
            <TextBlock Style="{StaticResource Overline}" Text="{l:T settings.group.protect}" Margin="4,26,0,10" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding RealtimeWatch}" />
                        <Border Style="{StaticResource RowIcon}"><TextBlock Style="{StaticResource Glyph}" Text="&#xE945;" Foreground="{StaticResource B.Accent}" /></Border>
                        <StackPanel Margin="14,0,20,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.realtime}" />
                            <TextBlock Style="{StaticResource RowDesc}" Text="{l:T settings.realtime.desc}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource RowSep}" />
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegHost}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Seg}" GroupName="Interval" Content="{l:T int.5}" IsChecked="{Binding SweepSeconds, Converter={StaticResource EqualsToBool}, ConverterParameter=5}" />
                                <RadioButton Style="{StaticResource Seg}" GroupName="Interval" Content="{l:T int.10}" IsChecked="{Binding SweepSeconds, Converter={StaticResource EqualsToBool}, ConverterParameter=10}" />
                                <RadioButton Style="{StaticResource Seg}" GroupName="Interval" Content="{l:T int.30}" IsChecked="{Binding SweepSeconds, Converter={StaticResource EqualsToBool}, ConverterParameter=30}" />
                                <RadioButton Style="{StaticResource Seg}" GroupName="Interval" Content="{l:T int.60}" IsChecked="{Binding SweepSeconds, Converter={StaticResource EqualsToBool}, ConverterParameter=60}" />
                                <RadioButton Style="{StaticResource Seg}" GroupName="Interval" Content="{l:T int.300}" IsChecked="{Binding SweepSeconds, Converter={StaticResource EqualsToBool}, ConverterParameter=300}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource RowIcon}"><TextBlock Style="{StaticResource Glyph}" Text="&#xE916;" Foreground="{StaticResource B.Green}" /></Border>
                        <StackPanel Margin="14,0,20,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.interval}" />
                            <TextBlock Style="{StaticResource RowDesc}" Text="{l:T settings.interval.desc}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource RowSep}" />
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding CleanTrayIcons}" />
                        <Border Style="{StaticResource RowIcon}"><TextBlock Style="{StaticResource Glyph}" Text="&#xE894;" Foreground="{StaticResource B.Purple}" /></Border>
                        <StackPanel Margin="14,0,20,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.ghost}" />
                            <TextBlock Style="{StaticResource RowDesc}" Text="{l:T settings.ghost.desc}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource RowSep}" />
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding NotifyOnKill}" />
                        <Border Style="{StaticResource RowIcon}"><TextBlock Style="{StaticResource Glyph}" Text="&#xEA8F;" Foreground="{StaticResource B.Amber}" /></Border>
                        <StackPanel Margin="14,0,20,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.notify}" />
                            <TextBlock Style="{StaticResource RowDesc}" Text="{l:T settings.notify.desc}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ── Startup ──────────────────────────────────────────── -->
            <TextBlock Style="{StaticResource Overline}" Text="{l:T settings.group.startup}" Margin="4,26,0,10" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding StartWithWindows}" />
                        <Border Style="{StaticResource RowIcon}"><TextBlock Style="{StaticResource Glyph}" Text="&#xE7E8;" Foreground="{StaticResource B.Accent2}" /></Border>
                        <StackPanel Margin="14,0,20,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.startup}" />
                            <TextBlock Style="{StaticResource RowDesc}" Text="{Binding StartupNote}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource RowSep}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Click="Elevate_Click" VerticalAlignment="Center"
                                Visibility="{Binding IsLimited, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xEA18;" FontSize="13" />
                                <TextBlock Text="{l:T btn.elevate}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Background="{StaticResource B.GreenSoft}" VerticalAlignment="Center"
                                Visibility="{Binding IsElevated, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="11" Foreground="{StaticResource B.Green}" />
                                <TextBlock Text="{l:T settings.admin.on}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource B.Green}" Margin="6,0,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource RowIcon}"><TextBlock Style="{StaticResource Glyph}" Text="&#xEA18;" Foreground="{StaticResource B.Green}" /></Border>
                        <StackPanel Margin="14,0,20,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.admin}" />
                            <TextBlock Style="{StaticResource RowDesc}" Text="{l:T settings.admin.desc}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ── Updates ──────────────────────────────────────────── -->
            <TextBlock Style="{StaticResource Overline}" Text="{l:T settings.group.update}" Margin="4,26,0,10" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding AutoUpdate}" />
                        <Border Style="{StaticResource RowIcon}"><TextBlock Style="{StaticResource Glyph}" Text="&#xE895;" Foreground="{StaticResource B.Blue}" /></Border>
                        <StackPanel Margin="14,0,20,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.autoupdate}" />
                            <TextBlock Style="{StaticResource RowDesc}" Text="{l:T settings.autoupdate.desc}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource RowSep}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Click="CheckUpdate_Click" VerticalAlignment="Center" IsEnabled="{Binding UpdateIdle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="13" />
                                <TextBlock Text="{l:T btn.checkUpdate}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Border Style="{StaticResource RowIcon}"><TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" Foreground="{StaticResource B.Muted}" /></Border>
                        <StackPanel Margin="14,0,20,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.version}" />
                                <TextBlock Text="{Binding VersionText}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource B.Accent}" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource RowDesc}" Text="{Binding UpdateStatus}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ── General ──────────────────────────────────────────── -->
            <TextBlock Style="{StaticResource Overline}" Text="{l:T settings.group.general}" Margin="4,26,0,10" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegHost}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Seg}" GroupName="Lang" Content="{l:T lang.auto}" IsChecked="{Binding Language, Converter={StaticResource EqualsToBool}, ConverterParameter=auto}" />
                                <RadioButton Style="{StaticResource Seg}" GroupName="Lang" Content="한국어" IsChecked="{Binding Language, Converter={StaticResource EqualsToBool}, ConverterParameter=ko}" />
                                <RadioButton Style="{StaticResource Seg}" GroupName="Lang" Content="English" IsChecked="{Binding Language, Converter={StaticResource EqualsToBool}, ConverterParameter=en}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource RowIcon}"><TextBlock Style="{StaticResource Glyph}" Text="&#xE774;" Foreground="{StaticResource B.Blue}" /></Border>
                        <StackPanel Margin="14,0,20,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.language}" />
                            <TextBlock Style="{StaticResource RowDesc}" Text="{Binding LanguageNote}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource RowSep}" />
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource BtnGhost}" Click="GitHub_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A7;" FontSize="12" />
                                    <TextBlock Text="GitHub" Margin="7,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource BtnGhost}" Click="Folder_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" FontSize="12" />
                                    <TextBlock Text="{l:T btn.dataFolder}" Margin="7,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource BtnDanger}" Click="Uninstall_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="12" />
                                    <TextBlock Text="{l:T btn.uninstall}" Margin="7,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Border Style="{StaticResource RowIcon}"><Image Source="/Assets/logo-64.png" Width="22" Height="22" /></Border>
                        <StackPanel Margin="14,0,20,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Tray Killer" />
                            <TextBlock Style="{StaticResource RowDesc}" Text="{l:T settings.about}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
