<Window x:Class="TrayKiller.UI.AddTargetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:TrayKiller.Core"
        Title="{l:T add.title}" Width="680" Height="700" MinHeight="560" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource B.Bg}" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource B.Text}"
        UseLayoutRounding="True" ResizeMode="CanResize">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid x:Name="Root" Background="{StaticResource B.Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Button Style="{StaticResource Caption.Close}" Content="&#xE8BB;" Click="Cancel_Click" HorizontalAlignment="Right" VerticalAlignment="Top"
                WindowChrome.IsHitTestVisibleInChrome="True" />

        <StackPanel Margin="28,26,28,0">
            <TextBlock Style="{StaticResource H1}" FontSize="22" Text="{l:T add.title}" />
            <TextBlock Style="{StaticResource Sub}" Text="{l:T add.sub}" Margin="0,6,0,0" />
            <Border Style="{StaticResource SegHost}" Margin="0,20,0,14" WindowChrome.IsHitTestVisibleInChrome="True">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabTray" Style="{StaticResource Seg}" GroupName="Src" IsChecked="True" Checked="Tab_Checked" Tag="tray">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7F4;" FontSize="12" />
                            <TextBlock Text="{l:T add.tab.tray}" Margin="7,0,0,0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabRunning" Style="{StaticResource Seg}" GroupName="Src" Checked="Tab_Checked" Tag="running">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE9D9;" FontSize="12" />
                            <TextBlock Text="{l:T add.tab.running}" Margin="7,0,0,0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabManual" Style="{StaticResource Seg}" GroupName="Src" Checked="Tab_Checked" Tag="manual">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;" FontSize="12" />
                            <TextBlock Text="{l:T add.tab.manual}" Margin="7,0,0,0" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- list mode -->
        <Grid x:Name="ListMode" Grid.Row="1" Margin="28,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBox x:Name="Search" Style="{StaticResource Input}" Padding="38,0,12,0" TextChanged="Search_TextChanged" />
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="13" Foreground="{StaticResource B.Subtle}" HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False" />
                <TextBlock Text="{l:T add.search}" Foreground="{StaticResource B.Subtle}" FontSize="13.5" Margin="39,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding Text, ElementName=Search, Converter={StaticResource NullToVis}}" />
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6" Margin="0,12,0,0">
                <Grid>
                    <ListBox x:Name="List" Background="Transparent" BorderThickness="0" Foreground="{StaticResource B.Text}" ItemContainerStyle="{StaticResource PickItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_MouseDoubleClick"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="11" Background="{StaticResource B.Surface2}">
                                        <Grid>
                                            <Image Source="{Binding Icon}" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xECAA;" Foreground="{StaticResource B.Muted}"
                                                       Visibility="{Binding Icon, Converter={StaticResource NullToVis}}" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Sub}" Style="{StaticResource Caption}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource Pill}" Background="{StaticResource B.GreenSoft}" Padding="9,3" VerticalAlignment="Center"
                                            Visibility="{Binding Running, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{l:T add.running}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource B.Green}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="ListStatus" Style="{StaticResource Sub}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{l:T add.loading}" />
                </Grid>
            </Border>
        </Grid>

        <!-- manual mode -->
        <StackPanel x:Name="ManualMode" Grid.Row="1" Margin="28,0" Visibility="Collapsed">
            <TextBlock Text="{l:T add.manual.name}" Style="{StaticResource Caption}" Margin="2,0,0,6" />
            <TextBox x:Name="ManualName" Style="{StaticResource Input}" />
            <TextBlock Text="{l:T add.manual.pattern}" Style="{StaticResource Caption}" Margin="2,16,0,6" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Margin="8,0,0,0" Click="Browse_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" FontSize="12" />
                        <TextBlock Text="{l:T btn.browse}" Margin="7,0,0,0" />
                    </StackPanel>
                </Button>
                <TextBox x:Name="ManualPattern" Style="{StaticResource Input}" FontFamily="{StaticResource MonoFont}" TextChanged="Manual_TextChanged" />
            </DockPanel>
            <Border CornerRadius="12" Padding="14,12" Background="{StaticResource B.Surface}" BorderBrush="{StaticResource B.Border}" BorderThickness="1" Margin="0,16,0,0">
                <DockPanel>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" Foreground="{StaticResource B.Blue}" VerticalAlignment="Top" Margin="0,1,0,0" />
                    <TextBlock Text="{l:T add.manual.hint}" Style="{StaticResource Caption}" FontSize="12.5" TextWrapping="Wrap" Margin="10,0,0,0" />
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- footer -->
        <Border Grid.Row="2" Background="{StaticResource B.Side}" BorderBrush="{StaticResource B.Border}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="28,16">
            <StackPanel>
                <TextBlock Text="{l:T add.options}" Style="{StaticResource Overline}" Margin="0,0,0,10" />
                <WrapPanel>
                    <CheckBox x:Name="OptAutostart" Style="{StaticResource Chip}" IsChecked="True" Content="{l:T rule.autostart}" ToolTip="{l:T rule.autostart.tip}" />
                    <CheckBox x:Name="OptHide" Style="{StaticResource Chip}" IsChecked="True" Content="{l:T rule.hideIcon}" ToolTip="{l:T rule.hideIcon.tip}" />
                    <CheckBox x:Name="OptServices" Style="{StaticResource Chip}" Content="{l:T rule.services}" ToolTip="{l:T rule.services.tip}" />
                </WrapPanel>
                <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource Btn}" Content="{l:T btn.cancel}" Click="Cancel_Click" MinWidth="88" />
                        <Button x:Name="AddButton" Style="{StaticResource BtnPrimary}" Click="Add_Click" Margin="10,0,0,0" MinWidth="120" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="12" Foreground="White" />
                                <TextBlock Text="{l:T add.confirm}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource B.Danger}" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
