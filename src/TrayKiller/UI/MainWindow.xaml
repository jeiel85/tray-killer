<Window x:Class="TrayKiller.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:TrayKiller.Core"
        xmlns:ui="clr-namespace:TrayKiller.UI"
        Title="Tray Killer" Width="1140" Height="800" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource B.Bg}"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource B.Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" Icon="/Assets/TrayKiller.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root" Background="{StaticResource B.Bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Sidebar ─────────────────────────────────────────────── -->
        <Border Background="{StaticResource B.Side}" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,20,16,18">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4,0,30">
                    <Grid Width="40" Height="40">
                        <Border CornerRadius="12" Background="{StaticResource B.AccentGrad}" Opacity="0.35">
                            <Border.Effect>
                                <BlurEffect Radius="14" />
                            </Border.Effect>
                        </Border>
                        <Image Source="/Assets/logo-128.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Tray Killer" FontSize="17" FontWeight="Bold" />
                        <TextBlock Text="{Binding VersionText}" FontSize="11.5" Foreground="{StaticResource B.Subtle}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- status card -->
                <Border DockPanel.Dock="Bottom" CornerRadius="14" Padding="14" Background="{StaticResource B.Surface}"
                        BorderBrush="{StaticResource B.Border}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="10" Height="10" VerticalAlignment="Center">
                                <Ellipse Fill="{Binding StatusBrush}" Opacity="0.35" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="DotPulse" />
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="2.2" Duration="0:0:1.6" />
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="2.2" Duration="0:0:1.6" />
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.5" To="0" Duration="0:0:1.6" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" />
                            </Grid>
                            <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold" FontSize="13" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{l:T side.admin}" Style="{StaticResource Caption}" Margin="20,6,0,0"
                                   Visibility="{Binding IsElevated, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{l:T side.limited}" Style="{StaticResource Caption}" Foreground="{StaticResource B.Amber}" Margin="20,6,0,0"
                                   Visibility="{Binding IsLimited, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <StackPanel>
                    <TextBlock Text="{l:T side.menu}" Style="{StaticResource Overline}" Margin="14,0,0,8" />
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource Nav}" IsChecked="True" Checked="Nav_Checked" Tag="dashboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE80F;" Width="22" />
                            <TextBlock Text="{l:T nav.dashboard}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavTargets" Style="{StaticResource Nav}" Checked="Nav_Checked" Tag="targets">
                        <DockPanel LastChildFill="False" HorizontalAlignment="Stretch">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE71D;" Width="22" />
                            <TextBlock Text="{l:T nav.targets}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            <Border DockPanel.Dock="Right" CornerRadius="8" Padding="7,1" Background="{StaticResource B.AccentSoft}"
                                    VerticalAlignment="Center" Visibility="{Binding HasRules, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding RuleCountText}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource B.Accent}" />
                            </Border>
                        </DockPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavActivity" Style="{StaticResource Nav}" Checked="Nav_Checked" Tag="activity">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE81C;" Width="22" />
                            <TextBlock Text="{l:T nav.activity}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" Checked="Nav_Checked" Tag="settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" Width="22" />
                            <TextBlock Text="{l:T nav.settings}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Content ─────────────────────────────────────────────── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource Caption.Btn}" Content="&#xE921;" Click="Minimize_Click" ToolTip="{l:T caption.minimize}" />
                <Button x:Name="MaxButton" Style="{StaticResource Caption.Btn}" Content="&#xE922;" Click="Maximize_Click" ToolTip="{l:T caption.maximize}" />
                <Button Style="{StaticResource Caption.Close}" Content="&#xE8BB;" Click="Close_Click" ToolTip="{l:T caption.close}" />
            </StackPanel>
            <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False" />
        </Grid>
    </Grid>
</Window>
